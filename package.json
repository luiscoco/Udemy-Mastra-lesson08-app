{
  "name": "udemy-mastra-lesson08-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mastra Studio and Execution Inspection \u2014 practical Mastra teaching application",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "npm start",
    "build:pages": "tsx scripts/build-pages.ts",
    "build:client": "tsc -p tsconfig.client.json --noEmit && esbuild src/client.ts --bundle --format=esm --target=es2022 --outfile=public/client.js",
    "build": "npm run build:pages && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "tsx tests/browser.ts",
    "sample": "tsx --env-file-if-exists=.env src/sample.ts",
    "sample:live": "tsx --env-file-if-exists=.env src/sample.ts --live",
    "studio": "mastra dev"
  },
  "dependencies": {
    "@mastra/core": "1.81.0",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "zod": "4.6.7",
    "@mastra/observability": "1.23.0",
    "@mastra/libsql": "1.28.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "mastra": "1.37.0"
  }
}
